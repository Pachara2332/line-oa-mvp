generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  BRAND_ADMIN
}

enum ClaimStatus {
  CLAIMED
  USED
  EXPIRED
  CANCELLED
}

model Brand {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  qrSources QrSource[]
  members   Member[]
  coupons   Coupon[]
  admins    AdminUser[]
}

model QrSource {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  code      String   @unique
  qrUrl     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  members   Member[]

  @@index([brandId])
}

model Member {
  id          String        @id @default(cuid())
  brandId     String
  sourceId    String
  lineUserId  String
  displayName String?
  phone       String?
  email       String?
  consentAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source      QrSource      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  claims      CouponClaim[]

  @@unique([brandId, lineUserId])
  @@index([brandId])
  @@index([sourceId])
}

model Coupon {
  id          String        @id @default(cuid())
  brandId     String
  title       String
  description String?
  quota       Int?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  brand       Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  claims      CouponClaim[]

  @@index([brandId])
  @@unique([brandId, title])
}

model CouponClaim {
  id        String      @id @default(cuid())
  couponId  String
  memberId  String
  claimedAt DateTime    @default(now())
  usedAt    DateTime?
  status    ClaimStatus @default(CLAIMED)
  coupon    Coupon      @relation(fields: [couponId], references: [id], onDelete: Cascade)
  member    Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([couponId, memberId])
  @@index([memberId])
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String?   @unique
  passwordHash String?
  email        String?   @unique
  lineUserId   String?   @unique
  name         String
  role         AdminRole
  brandId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  brand        Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([brandId])
}
